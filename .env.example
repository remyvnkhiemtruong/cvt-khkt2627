# Server-only environment variables. Never commit real secret values.
DATABASE_URL=
JWT_SECRET=

# Optional bootstrap passwords for creating missing official accounts on a fresh database.
# Existing accounts are never overwritten by these values.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_TEACHER_PASSWORD=
BOOTSTRAP_STUDENT_PASSWORD=
BOOTSTRAP_AI_PASSWORD=

# AI API integration is intentionally disabled at the current project phase.
AI_FEEDBACK_ENABLED=false
